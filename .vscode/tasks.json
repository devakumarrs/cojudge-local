{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "prepare-problem",
            "type": "process",
            "command": "${workspaceFolder}/.vscode/prepare-problem.sh",
            "args": [
                "${relativeFileDirname}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "group": "build",
            "problemMatcher": [],
            "presentation": {
                "reveal": "silent",
                "panel": "shared",
                "close": true
            }
        },
        {
            "label": "ship-problem",
            "type": "process",
            "command": "${workspaceFolder}/scripts/bash/ship-problem.sh",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "focus": false,
                "panel": "dedicated",
                "clear": true
            }
        }
    ]
}